{
  "name": "ChickenChase",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },
    "StarterGui": {
      "FarmerGUI": {
        "$className": "ScreenGui",
        "FarmerScript": {
          "$path": "src/client/FarmerScript.client.lua"
        },
        "Frame": {
          "$className": "Frame"
        }
      },
      "ChickenGUI": {
        "$className": "ScreenGui",
        "ChickenScript": { 
          "$path": "src/client/ChickenScript.client.lua"
        },
        "Frame": {
          "$className": "Frame",
          "UICorner": {
            "$className": "UICorner"
          },
          "UIStroke": {
            "$className": "UIStroke"
          },
          "TextBox": {
            "$className": "TextBox"
          }
        }
      },
      "CountdownGUI": {
        "$className": "ScreenGui",
        "TextLabel": {
          "$className": "TextLabel",
          "CountDownScript": {
            "$path": "src/client/CountdownScriptGUI.client.lua"
          }
        }
      }
    },
    "Workspace": { 
      "BearTrap": {
        "$className": "Model",
        "Close": {
          "$className": "Part"
        },
        "Open": {
          "$className": "Part"
        },
        "HitBox": {
          "$className": "Part",
          "TrapScript": {
            "$path": "src/server/TrapScript.server.lua"
          },
          "Bang": {
            "$className": "Sound"
          },
          "Captured": {
            "$className": "BoolValue"
          },
          "HitBox Terrain Joint": {
            "$className": "Weld"
          }
        }
      },
      "$properties": {
        "FilteringEnabled": true
      }
    },
    "Lighting": {
      "$className": "Lighting",
      "$properties": {
        "Ambient": [0, 0, 0],
        "Brightness": 2,
        "GlobalShadows": true,
        "Outlines": false,
        "Technology": "Voxel"
      }
    },
    "SoundService": {
      "$className": "SoundService",
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}
