{
  "name": "ChickenChase",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Shared": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "Server": {
        "$path": "src/server"
      },
      "TrapScript": {
        "$path": "src/server/TrapScript.server.lua"
      }
    },
    "StarterGui": {
      "$className": "StarterGui",
      "ChickenGUI": {
        "$className": "ScreenGui",
        "ChickenScript": {
          "$path": "src/client/ChickenScript.client.lua"
        },
        "Frame": {
          "$className": "Frame",
          "UICorner": {
            "$className": "UICorner"
          },
          "UIStroke": {
            "$className": "UIStroke"
          },
          "TextLabel": {
            "$className": "TextLabel"
          }
        }
      },
      "FarmerGUI": {
        "$className": "ScreenGui",
        "FarmerScript": {
          "$path": "src/client/FarmerScript.client.lua"
        },
        "Frame": {
          "$className": "Frame",
          "UICorner": {
            "$className": "UICorner"
          },
          "UIStroke": {
            "$className": "UIStroke"
          },
          "TextLabel": {
            "$className": "TextLabel"
          }
        }
      },
      "ShopGUI": {
        "$className": "ScreenGui",
        "MainFrame": {
          "$className": "Frame",
          "$properties": {
            "BackgroundTransparency": 1
          },
          "ShopFrame": {
            "$className": "Frame",
            "ScrollingFrame": {
              "$className": "ScrollingFrame"
            },
            "X": {
              "$className": "ImageButton",
              "XButtonScript": {
                "$path": "src/client/XButton.client.lua"
              }
            },
            "TextLabel": {
              "$className": "TextLabel"
            }
          },
          "SideButtonsFrame": {
            "$className": "Frame",
            "ShopButton": {
              "$className": "ImageButton",
              "ShopButtonScript": {
                "$path": "src/client/ShopButton.client.lua"
              }
            }
          }
        }
      },
      "CountdownGUI": {
        "$className": "ScreenGui",
        "TextLabel": {
          "$className": "TextLabel",
          "CountDownScript": {
            "$path": "src/client/CountdownScriptGUI.client.lua"
          }
        }
      }
    },
    "Workspace": {
      "$className": "Workspace",
      "$properties": {
        "FilteringEnabled": true
      },
      "BearTrap": {
        "$className": "Model",
        "Close": {
          "$className": "Part"
        },
        "Open": {
          "$className": "Part"
        },
        "HitBox": {
          "$className": "Part",
          "TrapScript": {
            "$path": "src/server/TrapScript.server.lua"
          },
          "Bang": {
            "$className": "Sound"
          },
          "Captured": {
            "$className": "BoolValue"
          },
          "HitBox Terrain Joint": {
            "$className": "Weld"
          }
        }
      }
    },
    "Lighting": {
      "$className": "Lighting",
      "$properties": {
        "Ambient": [0, 0, 0],
        "Brightness": 2,
        "GlobalShadows": true,
        "Outlines": false,
        "Technology": "Voxel"
      }
    },
    "SoundService": {
      "$className": "SoundService",
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}
